            </div>
        </div>
    </section>

    <!-- Footer Sitemap -->
    <footer class="footer" style="background: rgba(15,15,35,0.95); padding: 48px 20px 24px; margin-top: 64px; border-top: 2px solid rgba(255,215,0,0.2);">
        <div style="max-width: 1200px; margin: 0 auto;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; margin-bottom: 32px;">
                <div>
                    <h4 style="color: #FFD700; margin-bottom: 16px; font-size: 1.1rem;">Tech</h4>
                    <ul style="list-style: none; padding: 0; line-height: 2;">
                        <li><a href="/deep-dive.html#memory-governance" style="color: var(--text-light); text-decoration: none;">Memory & Governance</a></li>
                        <li><a href="/deep-dive.html#nbmf" style="color: var(--text-light); text-decoration: none;">NBMF Deep Dive</a></li>
                        <li><a href="/deep-dive.html#enterprise-dna" style="color: var(--text-light); text-decoration: none;">Enterprise-DNA</a></li>
                        <li><a href="/deep-dive.html#benchmarks" style="color: var(--text-light); text-decoration: none;">Benchmarks</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="color: #FFD700; margin-bottom: 16px; font-size: 1.1rem;">Security</h4>
                    <ul style="list-style: none; padding: 0; line-height: 2;">
                        <li><a href="/deep-dive.html#security-compliance" style="color: var(--text-light); text-decoration: none;">Security & Compliance</a></li>
                        <li><a href="/deep-dive.html#security-compliance" style="color: var(--text-light); text-decoration: none;">Security Features</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="color: #FFD700; margin-bottom: 16px; font-size: 1.1rem;">Resources</h4>
                    <ul style="list-style: none; padding: 0; line-height: 2;">
                        <li><a href="/deep-dive.html#benchmarks" style="color: var(--text-light); text-decoration: none;">Benchmarks</a></li>
                        <li><a href="/deep-dive.html#why-it-wins" style="color: var(--text-light); text-decoration: none;">Features</a></li>
                        <li><a href="/deep-dive.html#proof-validation" style="color: var(--text-light); text-decoration: none;">Proof & Validation</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="color: #FFD700; margin-bottom: 16px; font-size: 1.1rem;">Contact</h4>
                    <ul style="list-style: none; padding: 0; line-height: 2;">
                        <li><a href="/#contact" style="color: var(--text-light); text-decoration: none;">Contact Us</a></li>
                        <li><a href="/investor/portal" style="color: var(--text-light); text-decoration: none;">Investor Portal</a></li>
                        <li><a href="mailto:masoud.masoori@mas-ai.co" style="color: var(--text-light); text-decoration: none;">Email</a></li>

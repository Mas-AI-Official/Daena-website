    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-gold: #FFD700;
            --secondary-cyan: #00bcd4;
            --dark-bg: #0f0f23;
            --darker-bg: #1a1a3a;
            --accent-purple: #2a1a4a;
            --text-light: #ffffff;
            --text-muted: #b0b0b0;
            --gradient-primary: linear-gradient(135deg, #FFD700 0%, #00bcd4 100%);
            --gradient-bg: linear-gradient(135deg, #0f0f23 0%, #1a1a3a 50%, #2a1a4a 100%);
            --shadow-glow: 0 0 30px rgba(255, 215, 0, 0.3);
            --shadow-strong: 0 10px 40px rgba(0, 0, 0, 0.5);
            /* Glassmorphism variables */
            --glass-bg: rgba(5, 8, 20, 0.72);
            --glass-border: rgba(255, 255, 255, 0.06);
            --glass-shadow: 0 18px 40px rgba(0, 0, 0, 0.65);
            --glass-blur: blur(18px);
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: var(--gradient-bg);
            color: var(--text-light);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
        }
        
        /* Cover whole site with consistent background - unified black glassy universe */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at top, rgba(255, 215, 0, 0.12) 0%, transparent 55%),
                radial-gradient(circle at bottom, rgba(0, 188, 212, 0.08) 0%, transparent 60%),
                #02030a;
            z-index: -5;
            pointer-events: none;
        }

        /* Metatron's Cube Background - unified continuous background */
        .metatron-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -3;
            background: 
                radial-gradient(ellipse at center, rgba(255, 215, 0, 0.05) 0%, transparent 70%),
                linear-gradient(135deg, rgba(15, 15, 35, 0.95) 0%, rgba(26, 26, 58, 0.95) 50%, rgba(42, 26, 74, 0.95) 100%);
            pointer-events: none;
        }
        
        /* Glassmorphism Section Card - unified styling for all content containers */
        .section-card {
            background: rgba(5, 8, 20, 0.85);
            border-radius: 24px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--glass-shadow);
            backdrop-filter: var(--glass-blur);
            -webkit-backdrop-filter: var(--glass-blur);
            padding: 4rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            overflow-x: hidden;
            word-wrap: break-word;
            box-sizing: border-box;
        }
        
        /* Section wrapper - transparent, content in glass cards */
        .section-wrapper {
            padding: 6rem 2rem;
            background: transparent;
            position: relative;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        /* Metatron's Cube Pattern Background Image */
        .metatron-pattern-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -2;
            opacity: 0.05;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(255, 215, 0, 0.08) 0%, transparent 50%),
                url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><circle cx="200" cy="200" r="40" fill="none" stroke="%23FFD700" stroke-width="2" opacity="0.3"/><circle cx="200" cy="120" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><circle cx="280" cy="160" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><circle cx="280" cy="240" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><circle cx="200" cy="280" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><circle cx="120" cy="240" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><circle cx="120" cy="160" r="30" fill="none" stroke="%23FFD700" stroke-width="1.5" opacity="0.25"/><line x1="200" y1="200" x2="200" y2="120" stroke="%23FFD700" stroke-width="1" opacity="0.2"/><line x1="200" y1="200" x2="280" y2="160" stroke="%23FFD700" stroke-width="1" opacity="0.2"/><line x1="200" y1="200" x2="280" y2="240" stroke="%23FFD700" stroke-width="1" opacity="0.2"/><line x1="200" y1="200" x2="200" y2="280" stroke="%23FFD700" stroke-width="1" opacity="0.2"/><line x1="200" y1="200" x2="120" y2="240" stroke="%23FFD700" stroke-width="1" opacity="0.2"/><line x1="200" y1="200" x2="120" y2="160" stroke="%23FFD700" stroke-width="1" opacity="0.2"/></svg>');
            background-size: 600px 600px;
            background-position: center;
            background-repeat: repeat;
            pointer-events: none;
            animation: metatronRotate 60s linear infinite;
        }

        @keyframes metatronRotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Hexagonal Node Network Canvas */
        #metatron-hex-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        /* Navigation */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(15, 15, 35, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 2px solid rgba(255, 215, 0, 0.3);
            z-index: 1000;
            padding: 1rem 2rem;
            transition: all 0.3s ease;
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .logo:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.5));
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        .nav-links a {
            color: var(--text-light);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--gradient-primary);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-links a:hover {
            color: var(--primary-gold);
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 2rem 0 2rem;
            position: relative;
            margin-top: 0;
            background: rgba(0, 0, 0, 0.5);
        }

        .hero-content {
            max-width: 1000px;
            z-index: 10;
            position: relative;
            margin: 0 auto;
            width: 100%;
        }

        .hero h1 {
            font-size: clamp(48px, 8vw, 96px);
            font-weight: 800;
            margin-bottom: 1.5rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.1;
            animation: fadeInUp 1s ease-out;
        }

        .hero-subtitle {
            font-size: clamp(24px, 4vw, 36px);
            color: var(--text-muted);
            margin-bottom: 2rem;
            font-weight: 600;
            animation: fadeInUp 1s ease-out 0.2s both;
        }

        .hero-description {
            font-size: clamp(18px, 2.5vw, 22px);
            color: var(--text-light);
            margin-bottom: 3rem;
            max-width: 700px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.6;
            animation: fadeInUp 1s ease-out 0.4s both;
        }

        /* Problems Solved Section */
        .problems-solved {
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 2rem;
            margin: 2rem auto;
            max-width: 900px;
            backdrop-filter: blur(10px);
            animation: fadeInUp 1s ease-out 0.5s both;
        }

        .problem-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .problem-item {
            display: flex;
            align-items: center;
            padding: 1rem;
            background: rgba(255, 0, 0, 0.1);
            border: 1px solid rgba(255, 0, 0, 0.3);
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .problem-item:hover {
            background: rgba(255, 0, 0, 0.2);
            transform: translateY(-2px);
        }

        .problem-icon {
            font-size: 1.5rem;
            margin-right: 1rem;
        }

        .problem-text {
            color: var(--text-light);
            font-size: 1rem;
        }

        .cta-buttons {
            display: flex;
            gap: 2rem;
            justify-content: center;
            flex-wrap: wrap;
            animation: fadeInUp 1s ease-out 0.6s both;
        }

        .cta-main {
            font-size: 1.2rem;
            padding: 1.2rem 2.5rem;
            animation: bounce-in 2s ease-out 1s both;
        }

        .cta-secondary {
            font-size: 1.1rem;
            padding: 1.1rem 2.2rem;
            animation: slide-in-left 1.5s ease-out 1.2s both;
        }

        @keyframes bounce-in {
            0% {
                opacity: 0;
                transform: scale(0.3) translateY(-50px);
            }
            50% {
                opacity: 1;
                transform: scale(1.05) translateY(0);
            }
            70% {
                transform: scale(0.95);
            }
            100% {
                opacity: 1;
                transform: scale(1);
            }
        }

        @keyframes slide-in-left {
            0% {
                opacity: 0;
                transform: translateX(-100px);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .btn {
            padding: 1rem 2rem;
            border: none;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            position: relative;
            overflow: hidden;
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: var(--dark-bg);
            box-shadow: var(--shadow-glow);
            position: relative;
            overflow: hidden;
        }

        .btn-primary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s ease;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 20px 50px rgba(255, 215, 0, 0.6);
            animation: pulse-glow 1.5s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 20px 50px rgba(255, 215, 0, 0.6); }
            50% { box-shadow: 0 25px 60px rgba(255, 215, 0, 0.8); }
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-light);
            border: 2px solid var(--primary-gold);
            position: relative;
            overflow: hidden;
        }

        .btn-secondary::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: var(--gradient-primary);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .btn-secondary:hover::before {
            left: 0;
        }

        .btn-secondary:hover {
            color: var(--dark-bg);
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 15px 40px rgba(255, 215, 0, 0.4);
            border-color: var(--secondary-cyan);
        }

        /* Features Section */
        .features {
            padding: 6rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-title {
            text-align: center;
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 3rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 4rem;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 20px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        
        /* Daena Feature Cards - Matching mas-ai design */
        .daena-features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .daena-feature {
            padding: 2rem;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
            border-radius: 20px;
            border: 1px solid rgba(255, 215, 0, 0.1);
            transition: all 0.3s ease;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .daena-feature:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(255, 215, 0, 0.2);
            border-color: rgba(255, 215, 0, 0.3);
        }

        .daena-feature-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .daena-feature h4 {
            font-size: 1.3rem;
            color: var(--primary-gold);
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .daena-feature p {
            color: var(--text-muted);
            line-height: 1.6;
        }

        .feature-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.1), transparent);
            transition: left 0.5s ease;
        }

        .feature-card:hover::before {
            left: 100%;
        }

        .feature-card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-strong);
            border-color: var(--primary-gold);
        }

        /* Competitive Analysis Section */
        .competitive-analysis {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
        }

        .analysis-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        /* Competitor Cards - Mobile Optimized */
        .competitor-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .competitor-card {
            background: rgba(255, 0, 0, 0.1);
            border: 2px solid rgba(255, 0, 0, 0.3);
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.3s ease;
            min-width: 0;
            word-wrap: break-word;
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .competitor-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 0, 0, 0.2);
        }

        .competitor-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(255, 0, 0, 0.3);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .competitor-header h3 {
            color: var(--text-light);
            font-size: clamp(1.2rem, 3vw, 1.5rem);
            margin: 0;
            font-weight: 700;
            line-height: 1.3;
        }

        .competitor-status {
            background: rgba(255, 0, 0, 0.3);
            color: var(--text-light);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: bold;
            font-size: clamp(0.85rem, 2vw, 0.9rem);
            white-space: nowrap;
        }

        .limitations {
            margin-bottom: 1.5rem;
        }

        .limitations h4 {
            color: rgba(255, 0, 0, 0.9);
            margin-bottom: 1rem;
            font-size: clamp(1rem, 2.5vw, 1.1rem);
            font-weight: 600;
        }

        .daena-solution {
            background: rgba(255, 215, 0, 0.1);
            border-left: 4px solid var(--primary-gold);
            padding: 1.5rem;
            border-radius: 8px;
        }

        .daena-solution h4 {
            color: var(--primary-gold);
            margin-bottom: 1rem;
            font-size: clamp(1rem, 2.5vw, 1.1rem);
            font-weight: 600;
        }

        .limitations ul, .daena-solution ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .limitations li, .daena-solution li {
            padding: 0.75rem 0;
            color: var(--text-light);
            font-size: clamp(0.95rem, 2.5vw, 1rem);
            line-height: 1.6;
            font-weight: 500;
        }

        /* Daena Wins Card - Mobile Optimized */
        .daena-wins {
            background: linear-gradient(135deg, rgba(15,15,35,0.95), rgba(26,26,58,0.95));
            color: var(--text-light);
            border: 2px solid rgba(255,215,0,0.3);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 215, 0, 0.1);
            text-align: center;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .daena-wins:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 50px rgba(255, 215, 0, 0.2), inset 0 1px 0 rgba(255, 215, 0, 0.15);
            border-color: rgba(255,215,0,0.5);
        }

        .daena-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid rgba(255,215,0,0.2);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .daena-header h3 {
            color: var(--primary-gold);
            font-size: clamp(1.5rem, 4vw, 2rem);
            font-weight: bold;
            margin: 0;
            line-height: 1.2;
        }

        .daena-status {
            background: linear-gradient(135deg, rgba(255,215,0,0.2), rgba(255,215,0,0.1));
            color: var(--primary-gold);
            padding: 0.8rem 1.5rem;
            border-radius: 25px;
            font-weight: bold;
            font-size: clamp(0.9rem, 2.5vw, 1.1rem);
            white-space: nowrap;
            border: 1px solid rgba(255,215,0,0.3);
        }

        .daena-advantages {
            margin-bottom: 2rem;
        }

        .daena-advantages h4 {
            color: var(--primary-gold);
            margin-bottom: 1.5rem;
            font-size: clamp(1.2rem, 3vw, 1.5rem);
            font-weight: 700;
            text-align: center;
        }

        .advantages-list {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1.5rem;
            max-width: 1400px;
            margin: 0 auto;
        }

        .advantage-row {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2rem 1.5rem;
            background: rgba(15, 15, 35, 0.4);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 2px solid rgba(255, 215, 0, 0.3);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            -webkit-box-sizing: border-box;
            -moz-box-sizing: border-box;
            box-sizing: border-box;
            position: relative;
            overflow: hidden;
        }

        .advantage-row::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.1), transparent);
            transition: left 0.6s ease;
        }

        .advantage-row:hover::before {
            left: 100%;
        }

        .advantage-row:hover {
            background: rgba(15, 15, 35, 0.5);
            transform: translateY(-8px) scale(1.02);
            border-color: rgba(255, 215, 0, 0.6);
            box-shadow: 0 15px 40px rgba(255, 215, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        }

        .advantage-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            filter: drop-shadow(0 4px 8px rgba(255, 215, 0, 0.3));
            transition: all 0.3s ease;
        }

        .advantage-row:hover .advantage-icon {
            transform: scale(1.1) rotate(5deg);
            filter: drop-shadow(0 6px 12px rgba(255, 215, 0, 0.5));
        }

        .advantage-content {
            width: 100%;
        }

        .advantage-title {
            color: var(--primary-gold);
            font-size: clamp(1rem, 1.8vw, 1.2rem);
            font-weight: 700;
            margin-bottom: 0.75rem;
            line-height: 1.3;
        }

        .advantage-description {
            color: var(--text-light);
            font-size: clamp(0.85rem, 1.5vw, 0.95rem);
            line-height: 1.5;
            font-weight: 500;
        }

        .daena-result {
            background: rgba(255,215,0,0.1);
            border-radius: 15px;
            padding: 2rem;
            margin-top: 2rem;
            border: 1px solid rgba(255,215,0,0.2);
        }

        .daena-result h4 {
            color: var(--primary-gold);
            margin-bottom: 1rem;
            font-size: clamp(1.1rem, 3vw, 1.3rem);
            font-weight: 700;
        }

        .daena-result p {
            color: var(--text-light);
            font-size: clamp(1.1rem, 3vw, 1.3rem);
            font-weight: bold;
            margin: 0;
            line-height: 1.6;
        }

        /* AI Market Growth Section */
        .market-growth {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
        }

        .market-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .growth-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 4rem;
        }
        
        @media (max-width: 767.98px) {
            .growth-stats {
                grid-template-columns: 1fr !important;
                gap: 1rem !important;
            }
        }

        .growth-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(0, 188, 212, 0.3);
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .growth-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 188, 212, 0.2);
            border-color: var(--secondary-cyan);
        }

        .growth-number {
            font-size: 2.5rem;
            font-weight: bold;
            background: var(--gradient-secondary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .growth-label {
            color: var(--text-light);
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
        }

        .growth-trend {
            color: var(--secondary-cyan);
            font-size: 0.9rem;
            font-weight: bold;
        }

        .chart-container {
            background: rgba(0, 0, 0, 0.3);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 3rem;
            overflow-x: auto;
            max-width: 100%;
        }

        .growth-chart {
            display: flex;
            align-items: end;
            justify-content: space-around;
            height: 300px;
            gap: 1rem;
            min-width: 600px;
            max-width: 100%;
        }
        
        @media (max-width: 767.98px) {
            .chart-container {
                padding: 1rem !important;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            
            .growth-chart {
                min-width: 100%;
                height: 280px !important;
                gap: 0.5rem !important;
                padding: 0 0.5rem;
            }
            
            .chart-bar {
                width: clamp(45px, 12vw, 60px) !important;
                min-width: 45px;
            }
        }

        .chart-bar {
            background: var(--gradient-primary);
            border-radius: 10px 10px 0 0;
            width: 80px;
            position: relative;
            transition: all 0.3s ease;
            animation: growUp 2s ease-out;
        }

        .chart-bar:hover {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(255, 215, 0, 0.4);
        }

        @keyframes growUp {
            from { height: 0; }
            to { height: var(--height); }
        }

        .bar-value {
            position: absolute;
            top: -35px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--primary-gold, #FFD700);
            font-weight: 800;
            font-size: clamp(0.85rem, 3vw, 1rem);
            white-space: nowrap;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
            z-index: 10;
            background: rgba(0, 0, 0, 0.6);
            padding: 2px 6px;
            border-radius: 4px;
        }

        @media (max-width: 767.98px) {
            .bar-value {
                top: -40px !important;
                font-size: clamp(0.9rem, 3.5vw, 1.1rem) !important;
                font-weight: 900 !important;
                padding: 4px 8px !important;
                background: rgba(0, 0, 0, 0.8) !important;
                text-shadow: 0 2px 6px rgba(255, 215, 0, 0.5) !important;
            }
        }

        .bar-year {
            position: absolute;
            bottom: -28px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--text-light);
            font-size: clamp(0.75rem, 2.5vw, 0.9rem);
            font-weight: 700;
            white-space: nowrap;
        }

        @media (max-width: 767.98px) {
            .bar-year {
                bottom: -32px !important;
                font-size: clamp(0.8rem, 3vw, 1rem) !important;
                font-weight: 800 !important;
                color: var(--primary-gold, #FFD700) !important;
                text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
            }
        }

        .market-insight {
            background: rgba(255, 215, 0, 0.1);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            padding: 2rem;
        }

        /* Pitch Deck Animation */
        .pitch-deck {
            animation: pitchPulse 4s ease-in-out infinite;
        }

        @keyframes pitchPulse {
            0%, 100% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.02);
            }
        }

        .pitch-container {
            position: relative;
            overflow: hidden;
        }

        .pitch-container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.1) 0%, transparent 70%);
            animation: rotateGlow 8s linear infinite;
            pointer-events: none;
        }

        @keyframes rotateGlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .feature-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .feature-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: var(--text-light);
        }

        .feature-card p {
            color: var(--text-light);
            line-height: 1.7;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        /* Demo Section */
        .demo-section {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
            margin: 4rem 0;
        }

        .demo-container {
            max-width: 1200px;
            margin: 0 auto;
        }

        .demo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .demo-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 188, 212, 0.2);
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .demo-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--gradient-primary);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .demo-card:hover::before {
            opacity: 0.1;
        }

        .demo-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 188, 212, 0.3);
            border-color: var(--secondary-cyan);
        }

        .demo-icon {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            color: var(--secondary-cyan);
        }

        .demo-card h3 {
            font-size: 1.3rem;
            margin-bottom: 1rem;
            color: var(--text-light);
        }

        .demo-card p {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        /* Pitch Deck Section */
        .pitch-section {
            padding: 6rem 2rem;
            text-align: center;
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(0, 0, 0, 0.95);
            border-top: 3px solid rgba(255,215,0,0.3);
        }

        .pitch-content {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 25px;
            padding: 4rem;
            margin: 3rem 0;
        }

        .pitch-content h2 {
            font-size: 2.5rem;
            margin-bottom: 2rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .pitch-content p {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        .pitch-buttons {
            display: flex;
            gap: 1.5rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* Pitch Metrics */
        .pitch-metrics {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 2rem;
            margin: 3rem 0;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .metric-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 15px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .metric-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(255, 215, 0, 0.2);
            border-color: var(--primary-gold);
        }

        .metric-value {
            font-size: 2.5rem;
            font-weight: bold;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
            line-height: 1.2;
            word-wrap: break-word;
            overflow-wrap: break-word;
        }

        .metric-label {
            color: var(--text-muted);
            font-size: 1.1rem;
            font-weight: 500;
        }

        /* Recorded Demos Section */
        .recorded-demos {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
        }

        .recorded-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        .video-card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 215, 0, 0.2);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .video-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(255, 215, 0, 0.2);
            border-color: var(--primary-gold);
        }

        .video-thumbnail {
            position: relative;
            height: 200px;
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(0, 188, 212, 0.1));
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .play-button {
            font-size: 4rem;
            color: var(--primary-gold);
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .video-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
            padding: 1rem;
            color: var(--text-light);
        }

        .video-overlay h4 {
            color: var(--primary-gold);
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
        }

        .video-overlay p {
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        .video-info {
            padding: 1.5rem;
        }

        .video-info h3 {
            color: var(--text-light);
            margin-bottom: 0.5rem;
            font-size: 1.3rem;
        }

        .video-info p {
            color: var(--text-muted);
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        .video-duration {
            display: inline-block;
            background: var(--gradient-primary);
            color: var(--dark-bg);
            padding: 0.3rem 0.8rem;
            border-radius: 15px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .video-cta {
            text-align: center;
            margin-top: 3rem;
            padding: 2rem;
            background: rgba(255, 215, 0, 0.1);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
        }

        /* Contact Section */
        .contact {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
            text-align: center;
        }

        .contact-content {
            max-width: 800px;
            margin: 0 auto;
        }

        .contact h2 {
            font-size: 2.5rem;
            margin-bottom: 2rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .contact-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .contact-item {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .contact-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-glow);
        }

        .contact-item h3 {
            color: var(--primary-gold);
            margin-bottom: 1rem;
        }

        .contact-item a {
            color: var(--text-light);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .contact-item a:hover {
            color: var(--primary-gold);
        }

        /* Footer */
        .footer {
            background: rgba(0, 0, 0, 0.8);
            padding: 3rem 2rem 2rem;
            text-align: center;
            border-top: 1px solid rgba(255, 215, 0, 0.3);
        }

        .footer-content {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer p {
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-top: 2rem;
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .footer-links a:hover {
            color: var(--primary-gold);
        }

        /* Video Modal */
        .video-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10000;
            animation: fadeIn 0.3s ease-out;
        }

        .video-modal-content {
            background: var(--dark-bg);
            border-radius: 20px;
            padding: 2rem;
            max-width: 90%;
            max-height: 90%;
            position: relative;
            animation: scaleIn 0.3s ease-out;
        }

        .video-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .video-modal-header h3 {
            color: var(--primary-gold);
            margin: 0;
        }

        .video-modal-close {
            background: none;
            border: none;
            color: var(--text-light);
            font-size: 2rem;
            cursor: pointer;
            padding: 0;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .video-modal-close:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--primary-gold);
        }

        .video-modal-body video {
            width: 100%;
            max-width: 800px;
            height: auto;
            border-radius: 10px;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes scaleIn {
            from { transform: scale(0.8); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Global Mobile Fixes */
        * {
            -webkit-text-size-adjust: 100%;
            -moz-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            text-size-adjust: 100%;
        }
        
        body {
            overflow-x: hidden;
            word-wrap: break-word;
            word-break: break-word;
            hyphens: auto;
        }
        
        /* Prevent writing-mode for body copy */
        body, p, span, div, li, td, th, h1, h2, h3, h4, h5, h6 {
            writing-mode: horizontal-tb !important;
        }
        
        /* Ensure all text containers wrap properly - NO HYPHENATION */
        p, span, div, li, td, th {
            word-wrap: break-word;
            overflow-wrap: anywhere;
            word-break: normal;
            hyphens: none !important;
            max-width: 100%;
            white-space: normal !important;
        }
        
        /* Fix for long words - NO HYPHENATION */
        h1, h2, h3, h4, h5, h6 {
            word-wrap: break-word;
            overflow-wrap: break-word;
            hyphens: none !important;
            white-space: normal !important;
        }
        
        /* Responsive images and media */
        img, video {
            max-width: 100%;
            height: auto;
        }
        
        /* Fluid type scale */
        :root {
            --step--1: clamp(0.875rem, 0.83rem + 0.2vw, 0.975rem);
            --step-0: clamp(1rem, 0.9rem + 0.6vw, 1.125rem);
            --step-1: clamp(1.25rem, 1.1rem + 0.9vw, 1.5rem);
            --step-2: clamp(1.563rem, 1.2rem + 1.4vw, 1.95rem);
            --step-3: clamp(1.953rem, 1.4rem + 2.2vw, 2.44rem);
        }
        
        /* Responsive Design */
        /* Metric boxes responsive */
        @media (max-width: 1024px) {
            #investor-value .metric-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }
        }

        @media (max-width: 768px) {
            /* Mobile-specific fixes */
            body {
                font-size: 16px;
                line-height: 1.6;
            }
            
            /* Fix text truncation */
            .section-card, .feature-card, .daena-feature {
                padding: 1.5rem 1rem !important;
                margin: 0.5rem 0 !important;
                overflow: visible !important;
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
            }
            
            /* Fix grid layouts */
            .features-grid, .daena-features, [style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
                gap: 1.5rem !important;
            }
            
            /* Fix cards with multiple columns */
            [style*="grid-template-columns: repeat(3"] {
                grid-template-columns: 1fr !important;
            }
            
            [style*="grid-template-columns: repeat(4"] {
                grid-template-columns: 1fr !important;
            }
            
            /* Ensure all text is visible */
            p, span, div, li {
                white-space: normal !important;
                text-overflow: clip !important;
                overflow: visible !important;
            }
            
            /* Fix flex containers */
            [style*="display: flex"] {
                flex-wrap: wrap !important;
            }
            
            /* Fix metric boxes - stack on mobile */
            [style*="display: flex; gap"] {
                flex-direction: column !important;
                gap: 0.75rem !important;
            }
            
            /* Fix horizontal scroll issues */
            [style*="overflow-x"], [style*="overflow:"] {
                overflow-x: visible !important;
            }
            
            /* Fix any writing-mode issues */
            [style*="writing-mode"] {
                writing-mode: horizontal-tb !important;
            }
            
            /* Ensure no vertical text columns */
            [style*="column-count"], [style*="columns"] {
                column-count: 1 !important;
            }
            
            /* Fix any clipped text */
            [style*="clip"], [style*="text-overflow: ellipsis"] {
                clip: auto !important;
                text-overflow: clip !important;
                overflow: visible !important;
            }
            
            /* Fix icon sizes */
            .feature-icon, [style*="font-size: 3rem"], [style*="font-size: 2.5rem"] {
                font-size: 2rem !important;
            }
            
            /* Fix headings */
            h1 { font-size: clamp(1.75rem, 5vw, 2.5rem) !important; }
            h2 { font-size: clamp(1.5rem, 4vw, 2rem) !important; }
            h3 { font-size: clamp(1.25rem, 3vw, 1.75rem) !important; }
            h4 { font-size: clamp(1.1rem, 2.5vw, 1.5rem) !important; }
            
            /* Fix buttons and links */
            .btn, button, a[class*="btn"] {

            }

            .competitive-analysis {
                padding: 3rem 0.75rem !important;
                padding-top: 110px !important;
            }

            .market-growth {
                padding: 3rem 0.75rem !important;
                padding-top: 110px !important;
            }

            .demo-section {
                padding: 3rem 0.75rem !important;
                padding-top: 110px !important;
            }
        }

        /* Demo Form Section */
        .demo-form-section {
            padding: 6rem 2rem;
            background: rgba(0, 0, 0, 0.4);
            text-align: center;
        }

        .demo-form-container {
            max-width: 800px;
            margin: 0 auto;
        }

        .demo-form-container h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .demo-form {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 25px;
            padding: 3rem;
            margin-top: 2rem;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-bottom: 2rem;
        }

        .form-group {
            text-align: left;
        }

        .form-group label {
            display: block;
            color: var(--text-light);
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 1rem;
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 10px;
            background: rgba(0, 0, 0, 0.5);
            color: var(--text-light);
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: var(--primary-gold);
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.3);
        }

        .submit-btn {
            background: var(--gradient-primary);
            color: var(--dark-bg);
            padding: 1rem 3rem;
            border: none;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 1rem;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(255, 215, 0, 0.4);
        }

        /* Loading Animation */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--gradient-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255, 215, 0, 0.3);
            border-top: 4px solid var(--primary-gold);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loading-text {
            margin-top: 2rem;
            color: var(--text-light);
            font-size: 1.2rem;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1;             }
        }
        
        /* Cross-browser compatibility */
        @supports not (backdrop-filter: blur(20px)) {
            .nav, .stat-card, .project-card, .section-card {
                background: rgba(5, 8, 20, 0.95) !important;
            }
        }
        
        /* Smooth scroll for all browsers */
        @media (prefers-reduced-motion: no-preference) {
            html {
                scroll-behavior: smooth;
                -webkit-overflow-scrolling: touch;
            }
        }
        
        /* iOS Safari specific fixes */
        @supports (-webkit-touch-callout: none) {
            .section-card {
                -webkit-transform: translateZ(0);
                transform: translateZ(0);
            }
            
            input, textarea, select, button {
                font-size: 16px !important; /* Prevents zoom on iOS */
            }
        }
        
        /* Touch-friendly elements */
        @media (hover: none) and (pointer: coarse) {
            .btn, a, button {
                min-height: 44px;
                min-width: 44px;
                padding: 12px 24px;
            }
            
            .feature-card, .project-card {
                cursor: pointer;
            }
        }
        
        /* Firefox specific fixes */
        @-moz-document url-prefix() {
            .section-card {
                background: rgba(5, 8, 20, 0.9);
            }
        }
        
        /* Edge/IE fallbacks */
        @media screen and (-ms-high-contrast: active), (-ms-high-contrast: none) {
            .section-card {
                background: rgba(5, 8, 20, 0.95);
            }
            
            .daena-features, .features-grid {
                display: -ms-grid;
                -ms-grid-columns: 1fr 1fr 1fr;
            }
        }
        
        /* Additional mobile breakpoints */
        @media (max-width: 360px) {
            .hero h1 {
                font-size: 1.75rem !important;
            }
            
            .section-card {
                padding: 1rem 0.5rem !important;
            }
            
            .btn {
                font-size: 0.9rem !important;
                padding: 10px 16px !important;
            }
        }
        
        @media (min-width: 769px) and (max-width: 1024px) {
            .section-card {
                padding: 3rem 1.5rem;
            }
            
            .daena-features, .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* Mobile Typography & Overflow Fixes */
        .prose p {
            overflow-wrap: anywhere;
            word-break: normal;
            hyphens: auto;
        }

        .footnote-mark {
            font-size: 0.75rem;
            opacity: 0.7;
            vertical-align: super;
        }

        /* Hide vertical ribbons on mobile */
        @media (max-width: 768px) {
            .vertical-ribbon,
            [class*="ribbon"],
            [style*="writing-mode: vertical"] {
                display: none !important;
            }
        }

        /* Ensure all text wraps properly on mobile */
        @media (max-width: 768px) {
            * {
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }

            h1, h2, h3, h4, h5, h6 {
                white-space: normal;
                word-wrap: break-word;
                overflow-wrap: break-word;
            }

            p, li, span, div {
                hyphens: auto;
                word-break: normal;
                overflow-wrap: anywhere;
            }
        }

        /* Screen reader only class */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }
    </style>
</head>
<body>
    <!-- Metatron's Cube Background Layers -->
    <div class="metatron-bg"></div>
    <div class="metatron-pattern-bg"></div>
    <canvas id="metatron-hex-canvas"></canvas>
    <!-- Loading Overlay -->

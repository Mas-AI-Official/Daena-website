                    <span id="video-description" class="sr-only">Introduction video showcasing Daena AI's revolutionary AI Decision-Orchestration Platform with 48+ specialized agents, patent-pending Memory & Governance Engine, and VP-level autonomous decision-making capabilities.</span>
                </div>
            </div>
            
            <!-- Action Buttons -->
            <div style="display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-top: 48px;">
                <a href="/pitch-deck.html" class="btn btn-primary" style="padding: 16px 32px; font-size: clamp(1rem, 2vw, 1.1rem);" aria-label="Open Daena AI pitch deck PDF">
                    📄 Open Pitch Deck
                </a>
                <a href="/deep-dive.html" class="btn btn-secondary" style="padding: 16px 32px; font-size: clamp(1rem, 2vw, 1.1rem);" aria-label="View technical deep dive documentation">

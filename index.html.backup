                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }
            
            /* Fix breadcrumbs */
            .breadcrumb {
                font-size: 0.85rem !important;
                word-wrap: break-word !important;
            }
            
            /* Fix back links */
            .back-link {
                display: block;
                margin-bottom: 1rem;
                word-wrap: break-word;
            }
            
            .hero {
